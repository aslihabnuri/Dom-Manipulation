# ── Naratif — konfigurasi ────────────────────────────────────────────────────
# Salin file ini jadi `.env` lalu isi kuncinya. Jangan commit `.env`.

# WAJIB — otak aplikasi: riset topik, naskah, QC bahasa, caption.
# Ambil di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# WAJIB — generasi gambar, video, dubbing (TTS), dan transkripsi (STT).
# Ambil di https://kie.ai/api-key
KIE_API_KEY=

# OPSIONAL — dubbing langsung ke ElevenLabs (bypass KIE).
# Dipakai kalau kamu mau kontrol penuh atas voice cloning / voice settings.
# Kalau diisi, Naratif pakai ini untuk TTS+STT; kalau kosong, pakai KIE.
ELEVENLABS_API_KEY=

# ── Pilihan model (boleh dibiarkan default) ─────────────────────────────────
# Model Claude untuk naskah & riset. Naskah Indonesia paling bagus di Opus.
CLAUDE_MODEL=claude-opus-5

# Model gambar KIE untuk aset kolase gaya Vox.
KIE_IMAGE_MODEL=google/nano-banana-pro

# Model video KIE. Hanya dipakai kalau mode visual = "aigen".
# Mode default "collage" TIDAK memakai ini (lebih murah + lebih aman dari deteksi AI).
KIE_VIDEO_MODEL=veo3_fast

# Suara dubbing. Lihat daftar di `npm run cli -- voices`.
# Default dipilih untuk narasi dokumenter berbahasa Indonesia.
TTS_VOICE=Brian
TTS_STABILITY=0.55
TTS_SIMILARITY=0.80
TTS_STYLE=0.10
TTS_SPEED=1.0

# ── Batas biaya (pengaman supaya tidak kebablasan) ──────────────────────────
# Produksi otomatis berhenti kalau perkiraan biaya melewati angka ini (USD).
MAX_COST_PER_VIDEO_USD=3.00

# Ambang QC. Word Error Rate maksimum antara naskah dan hasil transkripsi dubbing.
# 0.05 = maksimal 5% kata meleset. Di atas ini, segmen di-regenerate otomatis.
MAX_WER=0.05

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4300
