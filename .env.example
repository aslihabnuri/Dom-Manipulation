# Password bersama untuk teman-teman (kosongkan = tanpa login, JANGAN kosong bila dipublikasikan ke internet)
APP_PASSWORD=ganti-dengan-password-kuat
# Set 1 bila dilayani lewat HTTPS (Render/Fly/Railway otomatis HTTPS)
COOKIE_SECURE=1
# Interval hitung ulang screener saat jam bursa (menit)
REFRESH_MINUTES=15
# Modal default untuk position sizing (Rp)
DEFAULT_EQUITY=100000000
# Opsional: klasifikasi sentimen berita dengan Claude. Tanpa ini dipakai leksikon.
# ANTHROPIC_API_KEY=sk-ant-...
# SENTIMENT_MODEL=claude-opus-5
# SENTIMENT_LLM=1
