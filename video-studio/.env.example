# Salin berkas ini menjadi .env lalu isi kuncinya.
# Berkas .env tidak akan pernah ikut terunggah ke GitHub.
#
# Cara termudah: jangan sentuh berkas ini sama sekali. Buka aplikasinya,
# lalu isi kunci lewat panel kiri. Aplikasi akan menuliskannya sendiri.

KIE_API_KEY=isi_kunci_kie_kamu_di_sini

# Opsional. Hanya perlu bila ingin memakai suara ElevenLabs langsung
# dengan akun sendiri, di luar Kie.
ELEVENLABS_API_KEY=
